# ============================================================
# Tribultz — Production Environment Template
# ============================================================
# Copie este arquivo para /opt/tribultz/.env na VM e preencha
# todos os campos marcados como REQUIRED.
#
# NUNCA commite o .env preenchido. Este template é seguro.
# ============================================================

# ── PostgreSQL (Magalu DBaaS) ─────────────────────────────────────────────────
# Formato: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# Host disponível no console Magalu após provisionar o DBaaS
POSTGRES_DB=tribultz
POSTGRES_USER=tribultz
POSTGRES_PASSWORD=REQUIRED_CHANGE_ME
POSTGRES_HOST=REQUIRED_HOST_FROM_MAGALU_CONSOLE
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://tribultz:REQUIRED_CHANGE_ME@REQUIRED_HOST_FROM_MAGALU_CONSOLE:5432/tribultz
DB_URL=postgresql+psycopg2://tribultz:REQUIRED_CHANGE_ME@REQUIRED_HOST_FROM_MAGALU_CONSOLE:5432/tribultz

# ── Redis (container local na VM) ────────────────────────────────────────────
# REDIS_PASSWORD: use `openssl rand -hex 24` para gerar
REDIS_PASSWORD=REQUIRED_CHANGE_ME
REDIS_URL=redis://:REQUIRED_CHANGE_ME@redis:6379/0
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
JWT_SECRET=REQUIRED_CHANGE_ME_openssl_rand_hex_32

# ── Magalu Object Storage (S3-compatible) ────────────────────────────────────
# Endpoint e credenciais disponíveis no console Magalu → Object Storage
S3_ENDPOINT=https://br-se1.magaluobjects.com
S3_REGION=br-se1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=tribultz-documents
S3_ACCESS_KEY=REQUIRED_FROM_MAGALU_CONSOLE
S3_SECRET_KEY=REQUIRED_FROM_MAGALU_CONSOLE

# ── Aplicação ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
ALLOWED_ORIGINS=https://tribultz.com.br,https://www.tribultz.com.br
FRONTEND_URL=https://tribultz.com.br

# ── Observabilidade / Sentry (error tracking) ────────────────────────────────
# Backend lê estas vars (app/config.py). Sem SENTRY_DSN o init é no-op.
# Pode ser definido aqui ou via workflow "ops-set-sentry.yml" (Actions).
# DSN obtido em: sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
CAPTCHA_ENABLED=true
TURNSTILE_SECRET_KEY=REQUIRED_FROM_CLOUDFLARE_DASHBOARD
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REQUIRED_CHANGE_ME@gmail.com
SMTP_PASSWORD=REQUIRED_APP_PASSWORD
SMTP_FROM_EMAIL=noreply@tribultz.com.br
SMTP_FROM_NAME=Tribultz
SMTP_TLS=true
EMAIL_VERIFICATION_ENABLED=true

# ── Asaas (pagamentos) ────────────────────────────────────────────────────────
# API Key obtida em: app.asaas.com → Configurações → Integrações → API Key
# ATENÇÃO: usar a chave de PRODUÇÃO (prefixo $aact_prod_...)
ASAAS_API_KEY=REQUIRED_FROM_ASAAS_DASHBOARD
ASAAS_ENVIRONMENT=production
#
# Webhook Token — gerado com: openssl rand -hex 32
# Configurar no Asaas Dashboard:
#   app.asaas.com → Configurações → Integrações → Webhooks → Adicionar
#   URL:   https://api.tribultz.com.br/api/v1/billing/webhooks/asaas
#   Token: (valor definido aqui em ASAAS_WEBHOOK_TOKEN)
#   Eventos: PAYMENT_CONFIRMED, PAYMENT_RECEIVED, PAYMENT_OVERDUE, SUBSCRIPTION_DELETED
ASAAS_WEBHOOK_TOKEN=REQUIRED_CHANGE_ME

# ── HubSpot (CRM) ────────────────────────────────────────────────────────────
HUBSPOT_ENABLED=false
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# ── AI / LLM (OpenRouter) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=REQUIRED_FROM_OPENROUTER
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CREW_MEMORY_TTL_SECONDS=3600
LLM_FREE_PRIMARY=openai/gpt-4o-mini
LLM_FREE_FALLBACK=anthropic/claude-haiku
LLM_PAID_FALLBACK=anthropic/claude-sonnet-4-5

# ── APIs Externas ─────────────────────────────────────────────────────────────
CLASSTRIB_API_URL=https://dfe-api.svrs.rs.gov.br/api/ClassTrib
CNPJ_PRIMARY_URL=https://publica.cnpj.ws/cnpj
CNPJ_FALLBACK_URL=https://brasilapi.com.br/api/cnpj/v1
