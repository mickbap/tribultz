      <RazaoSocial>EMPRESA ANONIMIZADA LTDA</RazaoSocial>
      <Endereco>
        <CodigoMunicipio>3550308</CodigoMunicipio>
        <Uf>SP</Uf>
      </Endereco>
    </PrestadorServico>

    <TomadorServico>
      <IdentificacaoTomador>
