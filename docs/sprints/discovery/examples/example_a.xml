      </Servico>

      <Valores>
        <ValorServicos>10000.00</ValorServicos>
        <BaseCalculo>10000.00</BaseCalculo>
        <AliquotaISS>0.0500</AliquotaISS>
        <ValorISS>500.00</ValorISS>
