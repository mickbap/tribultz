# ============================================================
# Tribultz Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ── Backend API ────────────────────────────────────────────
# Desenvolvimento:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Produção → configurar no Vercel Dashboard:
#   Project Settings → Environment Variables → NEXT_PUBLIC_API_BASE_URL
#   Valor: https://api.tribultz.com.br
#
# NOTA: se vazia, NewsFeed usa MOCK_NEWS (home page nunca fica em branco).

# ── Cloudflare Turnstile (CAPTCHA) ─────────────────────────
# Site Key pública — visível no browser, não é um secret.
# Obtida em: Cloudflare Dashboard → Turnstile → seu site → Site Key
#
# Chaves de teste oficiais Cloudflare (sempre funcionam em dev/CI):
#   Always-pass:  1x00000000000000000000AA
#   Always-fail:  2x00000000000000000000AB
#   Challenge:    3x00000000000000000000FF
#
# Produção → configurar no Vercel Dashboard:
#   Project Settings → Environment Variables → NEXT_PUBLIC_TURNSTILE_SITE_KEY
#   Valor: <Site Key real do painel Cloudflare>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
