# ============================================================
# Tribultz Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ── Backend API ────────────────────────────────────────────
# Development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Production (set this in Vercel Dashboard → Project Settings → Environment Variables):
# NEXT_PUBLIC_API_BASE_URL=https://api.tribultz.com.br
#
# NOTE: If this var is empty or missing on Vercel, NewsFeed falls back
# to MOCK_NEWS so the home page is never blank for leads.
