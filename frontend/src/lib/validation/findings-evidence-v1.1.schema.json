{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tribultz.local/schemas/findings-evidence-v1.1.json",
  "title": "Findings + Evidence v1.1",
  "type": "object",
  "required": ["job", "audit", "findings", "evidences"],
  "properties": {
    "job": {
      "type": "object",
      "required": ["id", "created_at", "tenant_id"],
      "properties": {
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "tenant_id": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "required": ["id", "job_id", "events"],
      "properties": {
        "id": { "type": "string" },
        "job_id": { "type": "string" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "action", "created_at", "payload"],
            "properties": {
              "id": { "type": "string" },
              "action": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" },
              "payload": { "type": "object" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "rule_id", "title", "where", "recommendation", "evidence_ids"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["FATAL", "ALERT"] },
          "rule_id": { "type": "string" },
          "title": { "type": "string" },
          "where": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "xpath": { "type": "string" },
              "snippet": { "type": "string" }
            }
          },
          "recommendation": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "enforcement": {
            "type": "object",
            "required": ["document_type", "rule_id", "version", "as_of", "legal_required", "schema_supported", "validation_rule_defined", "homologation_enforced", "production_enforced", "effective_from"],
            "properties": {
              "document_type": { "enum": ["NFSE", "NFE", "NFCE"] },
              "rule_id": { "type": "string" },
              "version": { "type": "string" },
              "as_of": { "type": "string", "format": "date" },
              "legal_required": { "type": "boolean" },
              "schema_supported": { "type": "boolean" },
              "validation_rule_defined": { "type": "boolean" },
              "homologation_enforced": { "type": "boolean" },
              "production_enforced": { "type": "boolean" },
              "effective_from": {
                "type": "object",
                "required": ["legal_required", "schema_supported", "validation_rule_defined", "homologation_enforced", "production_enforced"],
                "properties": {
                  "legal_required": { "type": ["string", "null"], "format": "date" },
                  "schema_supported": { "type": ["string", "null"], "format": "date" },
                  "validation_rule_defined": { "type": ["string", "null"], "format": "date" },
                  "homologation_enforced": { "type": ["string", "null"], "format": "date" },
                  "production_enforced": { "type": ["string", "null"], "format": "date" }
                }
              }
            }
          }
        }
      }
    },
    "evidences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["xml", "link", "print", "job", "audit"] },
          "label": { "type": "string" },
          "href": { "type": "string" },
          "xpath": { "type": "string" },
          "snippet": { "type": "string" }
        }
      }
    }
  }
}
