{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Next.js)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["/c/Program Files/nodejs/node_modules/npm/bin/npm-cli.js", "run", "dev"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Infra (Docker Compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "infra/docker-compose.yml", "up", "-d"],
      "port": 8000
    }
  ]
}
